{
  "name": "royal-game-of-ur",
  "private": true,
  "description": "The Royal Game of Ur, played in the browser.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "html-validate index.html",
    "typecheck": "tsc -p jsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run build:shared && node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build:shared": "node scripts/shared-module.mjs",
    "build": "npm run build:shared && node scripts/build.mjs",
    "lighthouse": "npm run build && lhci autorun",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "espree": "11.2.0",
    "globals": "16.4.0",
    "html-minifier-terser": "7.2.0",
    "html-validate": "11.17.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.9.10",
    "stylelint": "16.24.0",
    "stylelint-config-standard": "39.0.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write",
      "html-validate"
    ],
    "*.{json,md,webmanifest,yml,yaml}": "prettier --write"
  }
}
