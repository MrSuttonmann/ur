// The site and its online rooms as one Cloudflare Worker: dist/ is served as static assets, and /api/* goes to
// worker/index.mjs, which hands each room to its own Room Durable Object.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ur",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "env": {
    // the end-to-end tests' Worker, with the test hooks on; bindings aren't inherited, so the rooms are bound again
    "e2e": {
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
      },
      "vars": { "TEST_HOOKS": "1" },
    },
  },
}
